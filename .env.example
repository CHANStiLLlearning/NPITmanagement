# Production Environment Variables
PROJECT_NAME="School Management System"
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=school_db
DATABASE_URL=postgresql://admin:your_strong_db_password_here@db:5432/school_db

# Security & Tokens
SECRET_KEY=generate_a_random_secret_key_here_using_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend API URL (leave empty if NGINX proxies /api automatically)
VITE_API_BASE_URL=
